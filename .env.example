# Copy to .env and adjust. All values are optional; defaults live in src/medrag/config.py.

# Vector store
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=medrag

# Models
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1   # BAAI/bge-reranker-v2-m3 on >= 16 GB
DEVICE=cpu             # query-time embedder + re-ranker: cpu keeps the GPU for the LLM
INGEST_DEVICE=auto     # auto | cpu | mps | cuda

# "Not found" thresholds: best dense cosine / best re-ranker score below these = refuse
MIN_DENSE_SCORE=0.60
MIN_RERANK_SCORE=0.50

# Chunking (characters)
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# LLM: local by default. Set LLM_PROVIDER=openai to opt in to a cloud API.
LLM_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Evaluation judge (RAGAS)
JUDGE_PROVIDER=ollama
JUDGE_MODEL=qwen2.5:3b

# Limits
MAX_QUESTION_CHARS=500
MAX_CONTEXT_TOKENS=3000
MAX_TOP_K=20
REQUEST_TIMEOUT_S=60
